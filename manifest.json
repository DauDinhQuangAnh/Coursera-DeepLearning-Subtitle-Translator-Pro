{
    "manifest_version": 3,
    "name": "Coursera & DeepLearning Subtitle Translator Pro",
    "description": "Dịch phụ đề song ngữ chuẩn xác, mượt mà trên Coursera và Deeplearning.ai",
    "version": "1.2.0",
    "icons": {
        "16": "icons/icon.png",
        "32": "icons/icon.png",
        "48": "icons/icon.png",
        "128": "icons/icon.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon.png",
            "32": "icons/icon.png",
            "48": "icons/icon.png",
            "128": "icons/icon.png"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.coursera.org/*",
                "*://*.deeplearning.ai/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "permissions": [
        "storage",
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "*://*.coursera.org/*",
        "*://*.deeplearning.ai/*",
        "https://translate.googleapis.com/*"
    ]
}